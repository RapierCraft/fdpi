{
  "schema": "forgedock.config/v1",
  "repository": {
    "provider": "github",
    "name": "RapierCraft/fdpi"
  },
  "state": {
    "branch": "forgedock/state/v1",
    "leaseSeconds": 3600,
    "heartbeatSeconds": 60
  },
  "branches": {
    "integration": ["staging"],
    "protected": ["main"],
    "autoMergeIntegration": true
  },
  "verification": {
    "commands": {
      "test": {
        "argv": ["npm", "test"],
        "required": true,
        "timeoutMs": 120000
      }
    }
  },
  "review": {
    "required": ["forge-review-correctness", "forge-review-security"],
    "maxRounds": 3
  },
  "subagents": {
    "maxConcurrent": 2,
    "maxDepth": 2
  }
}
